# API Configuration
PROJECT_NAME="Smart City AI Traffic Management"
API_V1_STR="/api/v1"
SECRET_KEY="your-super-secret-key-for-jwt"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration
# Update YOUR_PASSWORD below with your actual MySQL Workbench password
DATABASE_URL="mysql+pymysql://root:root@localhost:3306/traffic_db"

# AI Model Configuration
YOLO_MODEL_N="yolov8n.pt"
YOLO_MODEL_X="yolov8x.pt"

# Redis Configuration
REDIS_HOST="localhost"
REDIS_PORT=6379

# CCTV Streams
VIDEO_PATH_1="videos/Junction 1.mp4"
VIDEO_PATH_2="videos/Junction 2.mp4"
VIDEO_PATH_3="videos/Junction 3.mp4"
VIDEO_PATH_4="videos/Junction 4.mp4"
